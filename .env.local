# Copia este archivo a .env.local y rellena con tus valores reales.
# .env.local NUNCA se sube a git (ya está en .gitignore).

# Dominio de tu tienda Shopify (sin https://, sin barra final)
SHOPIFY_STORE_DOMAIN=

# Storefront API access token de la Custom App de Getzemani en Shopify Admin
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Nota: la versión de la API está fijada en lib/shopify.ts (2026-01).
# No hace falta una variable SHOPIFY_API_VERSION.
